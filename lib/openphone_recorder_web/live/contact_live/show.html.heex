<.header>
  Contact <%= @contact.id %>
  <:subtitle>This is a contact record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/contacts/#{@contact}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit contact</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Full name"><%= @contact.first_name %></:item>
  <:item title="Full name"><%= @contact.last_name %></:item>
  <:item title="External"><%= @contact.external_id %></:item>
  <:item title="Source"><%= @contact.source %></:item>
</.list>

<.back navigate={~p"/contacts"}>Back to contacts</.back>

<.modal
  :if={@live_action == :edit}
  id="contact-modal"
  show
  on_cancel={JS.patch(~p"/contacts/#{@contact}")}
>
  <.live_component
    module={OpenphoneRecorderWeb.ContactLive.FormComponent}
    id={@contact.id}
    title={@page_title}
    action={@live_action}
    contact={@contact}
    account_id={@user_setting.selected_account_id}
    patch={~p"/contacts/#{@contact}"}
  />
</.modal>
