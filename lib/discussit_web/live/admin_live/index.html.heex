<.header>
  Admin
</.header>

<h2>Set Count</h2>

<.form :let={_f} for={%{}} as={:consumer} id="count-form" phx-submit="set_count">
  <input id={:count} name={:count} /><br />
  <button class="btn btn-success">Save</button>
</.form>
<button class="btn btn-success" phx-click="start">Start</button>
<button class="btn btn-success" phx-click="seeds">Seed</button>
