<.header>
  Credit <%= @credit.id %>
  <:subtitle>This is a credit record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/credits/#{@credit}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit credit</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Product"><%= @credit.product_id %></:item>
  <:item title="Quantity"><%= @credit.quantity %></:item>
  <:item title="Purchased at"><%= @credit.purchased_at %></:item>
</.list>

<.back navigate={~p"/credits"}>Back to credits</.back>

<.modal :if={@live_action == :edit} id="credit-modal" show on_cancel={JS.patch(~p"/credits/#{@credit}")}>
  <.live_component
    module={DiscussitWeb.CreditLive.FormComponent}
    id={@credit.id}
    title={@page_title}
    action={@live_action}
    credit={@credit}
    patch={~p"/credits/#{@credit}"}
  />
</.modal>
