<div class="flex flex-col overflow-y-auto h-screen w-full">
  <div class="flex flex-row w-full bg-base-300 py-2 px-4 sticky top-0 z-10 mb-2 gap-x-2 items-center">
    <.back class="mt-0" navigate={~p"/conversations/#{@conversation_summarizer.conversation_id}"}>
    </.back>
    Summary <%= @conversation_summarizer.summarizer.name %> for Conversation
  </div>

  <div class="container mx-auto py-12 space-y-4">
    <div :for={summary <- @conversation_summarizer.summaries}>
      <div class="card w-full bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title">
            <%= format_date_time(summary.summary_interval.lower) %> to <%= format_date_time(
              summary.summary_interval.upper
            ) %>
          </h2>
          <p><%= summary.content %></p>
          <div class="card-actions justify-end">
            <.link
              phx-click="delete-summary"
              phx-value-id={summary.id}
              class="btn btn-xs btn-error"
            >
              Delete
            </.link>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
