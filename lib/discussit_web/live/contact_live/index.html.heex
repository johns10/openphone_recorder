<div class="flex flex-col overflow-y-scroll min-w-fit h-screen">
  <div id="contacts" phx-update="stream" class="flex flex-col">
    <div    
      :for={{id, contact} <- @streams.contacts}
      class="flex flex-row"
      id={id}
    >
      <.link 
        id={"edit-#{id}"}
        patch={~p"/contacts/#{contact.id}/edit"}
        class="w-full px-4 py-2 conversations hover:bg-base-200"
      >
        <.render_contact_name contact={contact} />
      </.link>
      <.link 
        id={"delete-#{id}"}
        phx-click={JS.push("delete", value: %{id: contact.id}) |> hide("#{id}")}
        data-confirm="Are you sure?"
        class="px-2 py-2 conversations hover:bg-base-200"
      >
        <.icon name="hero-trash" class="w-4 h-4" />
      </.link>
    </div>
  </div>
  <div
    :if={!@end_of_timeline?}
    id="last-element"
    phx-hook="ElementVisible"
    class="pb-[calc(100vh)]"
  />
  <div :if={@end_of_timeline?} id="last-element" class="mx-2">Last Contact</div>
</div>
<div class="flex flex-col overflow-y-scroll overflow-x-hidden flex-grow">
  <div class="flex flex-row-reverse w-full bg-base-300 justify-between py-2 px-4 sticky top-0 z-10 mb-2">
    <.link patch={~p"/contacts/new"}>
      <.button class="btn-sm btn-success">New Contact</.button>
    </.link>
  </div>
  <div class="p-4">
    <.live_component
      :if={@contact}
      module={DiscussitWeb.ContactLive.FormComponent}
      id={@contact.id || :new}
      title={@page_title}
      action={@live_action}
      contact={@contact}
      account_id={@current_user.selected_account_id}
      patch={~p"/contacts"}
      attrs={@attrs}
    />
  </div>
</div>