<style>
  body {
    min-height: 100vh;
    min-height: -moz-available;
    min-height: -webkit-fill-available;
    min-height: fill-available;
  }

  html {
    height: fill-available;
    height: -webkit-fill-available;
  }
</style>

<div class="flex flex-col w-full overflow-y-scroll">
  <div class="flex flex-row w-full bg-base-300 items-center justify-between py-2 px-4 sticky top-0 z-10">
    <div class="flex flex-row items-center gap-x-8">
      Topics
      <div role="tablist" class="tabs tabs-bordered">
        <.link
          navigate={~p"/topics?tab=index"}
          role="tab"
          class={["tab", if(@tab == :index, do: "tab-active")]}
        >
          Index
        </.link>
        <.link
          :if={@last_model}
          navigate={~p"/topics/?#{[model_id: @last_model.id]}&tab=migrate"}
          role="tab"
          class={["tab", if(@tab == :migrate, do: "tab-active")]}
        >
          Migrate
        </.link>
        <a role="tab" class="tab">Heirarchy</a>
      </div>
    </div>
    <div>
      <.link
        :if={@latest_model}
        class="btn btn-sm"
        phx-click="regenerate-labels"
        data-confirm="Are you sure? Regenerating topics will relabel all your existing topics."
      >
        Relabel
      </.link>

      <.link class="btn btn-sm" patch={~p"/topics/train"} phx-click={JS.push_focus()}>
        Train
      </.link>

      <.link
        :if={@latest_model}
        class="btn btn-sm"
        phx-click="reset-model"
        data-confirm="This action will delete all automatically generated topics that haven't been used in your conversations."
      >
        Reset
      </.link>
    </div>
  </div>

  <div
    class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-4 m-4"
    id="topics"
    phx-update="stream"
  >
    <.topic_card
      :for={{id, topic} <- @streams.topics}
      topic={topic}
      to_model={@latest_model}
      id={id}
      mode={@tab}
    />
  </div>

  <.modal :if={@live_action in [:edit]} id="topic-modal" show on_cancel={JS.patch(~p"/topics")}>
    <.live_component
      module={DiscussitWeb.TopicLive.FormComponent}
      id={@topic.id}
      title={@page_title}
      action={@live_action}
      topic={@topic}
      patch={~p"/topics"}
    />
  </.modal>
  <.modal :if={@live_action == :train} id="training-modal" show on_cancel={JS.patch(~p"/topics")}>
    <.live_component
      module={DiscussitWeb.TopicLive.TrainingFormComponent}
      id="training-form"
      title={@page_title}
      patch={~p"/topics"}
      model_id={if(@latest_model, do: @latest_model.id, else: nil)}
      account_id={@current_user.selected_account.id}
      current_user={@current_user}
    />
  </.modal>
</div>
