<div class="flex flex-col overflow-y-scroll min-w-fit h-screen">
  <div id="conversations" phx-update="stream">
    <div
      :for={{id, conversation} <- @streams.conversations}
      class="w-full px-4 py-2 conversations hover:bg-base-200"
      id={id}
    >
      <%= case conversation do %>
        <% %{participants: [first, second]} = conversation -> %>
          <.link phx-click={JS.patch(~p{/conversations/#{conversation.id}})}>
            <div class="flex flex-col">
              <div class="flex flex-row">
                <.participant participant={first} class="font-bold" />
              </div>
              <div class="flex flex-row">
                <.participant participant={second} class="font-light" />
              </div>
            </div>
          </.link>
        <% %{participants: participants} = conversation -> %>
          <div class="flex flex-col">
            <.link phx-click={JS.patch(~p{/conversations/#{conversation.id}})}>
              <span class="font-bold"><%= Enum.count(participants) %> participants</span>
              <div class="flex flex-row">
                <.participant participant={Enum.at(participants, 0)} class="font-bold" />
                <span class="ml-1">+<%= Enum.count(participants) - 1 %></span>
              </div>
            </.link>
          </div>
      <% end %>
    </div>
  </div>
  <div
    :if={!@end_of_timeline?}
    id="last-element"
    phx-hook="ElementVisible"
    class="pb-[calc(100vh)]"
  />
  <div :if={@end_of_timeline?} id="last-element" class="mx-2">Last Conversation</div>
</div>
<div class="flex flex-col overflow-y-scroll overflow-x-hidden flex-grow">
  <.participant_header
    conversation={@conversation}
    worker_busy?={@worker_busy?}
    zoom_level={@zoom_level}
    transcription_status={@transcription_status}
    current_user={@current_user}
  />
  <div id="statements" class="flex flex-col" phx-update="stream">
    <%= for {id, conversation_item} <- @streams.conversation_items do %>
      <%= case conversation_item do %>
        <% %{type: "statement", data: statement} -> %>
          <div id={id}>
            <div class="px-4 w-full flex flex-row items-center space-x-2">
              <div class="text-xs">
                <%= render_date(statement.occurred_at, @current_user) %>
              </div>
            </div>
            <div class="card bg-neutral mx-2 my-2">
              <div class={[
                "card-body p-4",
                if(statement.call_id, do: "chat-bubble-accent"),
                if(statement.meeting_id, do: "chat-bubble-primary")
              ]}>
                <div class="card-title text-base">
                  <div class="flex flex-grow justify-between">
                    <.participant participant={statement.participant} class="" />
                    <.searchable_drop_down
                      parent_id={statement.id}
                      initial_value={safe_topic_title(statement)}
                      id={"#{statement.id}"}
                      search_results={@search_results}
                      model_topic_id={statement.model_topic_id}
                    />
                  </div>
                </div>
                <%= statement.content %>
              </div>
            </div>
          </div>
        <% %{type: "call_missed", timestamp: timestamp, data: call} -> %>
          <div id={id}>
            <div class="text-xs px-4">
              <%= render_date(timestamp, @current_user) %>
            </div>
            <div class="chat flex flex-row px-4">
              <div class="chat-bubble z-0 flex flex-row items-center space-x-2">
                <.icon name="hero-phone-x-mark" class="w-5 h-5 bg-error" />
                <.participant participant={call.from_participant} class="" />
              </div>
            </div>
          </div>
        <% %{type: "call_started", data: call, timestamp: timestamp} -> %>
          <div id={id}>
            <div class="text-xs px-4">
              <%= render_date(timestamp, @current_user) %>
            </div>
            <div class="chat flex flex-row px-4">
              <div class="chat-bubble z-0 flex flex-row items-center space-x-2">
                <.participant participant={call.from_participant} class="" />
                <.icon name="hero-phone-arrow-up-right" class="w-5 h-5 bg-success" />
                <.participant participant={call.to_participant} class="" />
              </div>
            </div>
          </div>
        <% %{type: "call_ended", timestamp: timestamp, data: call} -> %>
          <div id={id}>
            <div class="text-xs px-4">
              <%= render_date(timestamp, @current_user) %>
            </div>
            <div class="chat flex flex-row px-4">
              <div class="chat-bubble z-0 flex flex-row items-center space-x-4">
                <.icon name="hero-phone-arrow-down-left" class="w-5 h-5 bg-error" />
                <%= case call do %>
                  <% %{status: :file_uploaded, call_recording: recording, voicemail: voicemail} when recording != nil or voicemail != nil -> %>
                    <.transcribe_call_button call={call} account={@current_user.selected_account} />
                  <% %{status: :transcribing} -> %>
                    <.button class="btn-primary btn-sm" disabled>
                      <.icon name="hero-arrow-path" class="mr-2 w-5 h-5 animate-spin" />
                      Transcribing ...
                    </.button>
                  <% %{status: :transcribed} -> %>
                    <.icon name="hero-check-circle" class="ml-4 w-5 h-5 bg-success" />
                  <% %{status: :upload_empty} -> %>
                    <.icon name="hero-exclamation-circle" class="ml-4 w-5 h-5 bg-warning" />
                    <span class="text-warning">Call Recording Empty</span>
                  <% %{status: :upload_failed} -> %>
                    <.icon name="hero-exclamation-circle" class="ml-4 w-5 h-5 bg-warning" />
                    <span class="text-error">Error Uploading Recording</span>
                <% end %>
              </div>
            </div>
          </div>
        <% %{type: "meeting_started", timestamp: timestamp} -> %>
          <div id={id}>
            <div class="text-xs px-4">
              <%= render_date(timestamp, @current_user) %>
            </div>
            <div class="chat flex flex-row px-4">
              <div class="chat-bubble z-0 flex flex-row items-center space-x-2">
                <.icon name="hero-calendar-days" class="mr-2 w-5 h-5" /> Meeting Started
              </div>
            </div>
          </div>
        <% %{type: "daily_summary", timestamp: timestamp, data: summary} -> %>
          <div id={id}>
            <div class="text-xs px-4">
              <%= render_day(timestamp, @current_user) %>
            </div>
            <div class="chat chat-start" id={id}>
              <div class="chat-bubble chat-bubble-secondary z-0">
                <%= summary.content %>
              </div>
            </div>
          </div>
        <% %{type: "weekly_summary", timestamp: timestamp, data: summary} -> %>
          <div id={id}>
            <div class="text-xs px-4">
              <%= render_week(timestamp, @current_user) %>
            </div>
            <div class="chat chat-start" id={id}>
              <div class={["chat-bubble z-0"]}>
                <%= summary.content %>
              </div>
            </div>
          </div>
        <% %{type: "monthly_summary", timestamp: timestamp, data: summary} -> %>
          <div id={id}>
            <div class="text-xs px-4">
              <%= render_month(timestamp, @current_user) %>
            </div>
            <div class="chat chat-start" id={id}>
              <div class={["chat-bubble z-0"]}>
                <%= summary.content %>
              </div>
            </div>
          </div>
      <% end %>
    <% end %>
  </div>
  <div class="flex-grow" />
</div>

<.paywall_modal current_user={@current_user} hide_modal={true} />
